<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FreeFlow_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FreeFlow_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock
                Text="Stored at %LOCALAPPDATA%\FreeFlow\settings.json. API keys are encrypted with DPAPI."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar Grid.Row="1" x:Name="ValidationBar" IsOpen="False" IsClosable="False" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="20">

                <StackPanel Spacing="8">
                    <TextBlock Text="Transcription provider" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox x:Name="TranscriptionBaseUrl" Header="Base URL" />
                    <PasswordBox x:Name="TranscriptionApiKey" Header="API key" />
                    <TextBox x:Name="TranscriptionModel" Header="Model (Azure: deployment name)" />
                    <TextBox
                        x:Name="TranscriptionApiVersion"
                        Header="Azure API version"
                        PlaceholderText="Leave blank for OpenAI/Groq; e.g. 2025-03-01-preview for Azure" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Post-processing (cleanup)" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Name="PostProcessingEnabled" Header="Enable cleanup" OnContent="On" OffContent="Off" />
                    <TextBox x:Name="PostProcessingBaseUrl" Header="Base URL" />
                    <PasswordBox x:Name="PostProcessingApiKey" Header="API key" />
                    <TextBox x:Name="PostProcessingModel" Header="Model (Azure: deployment name)" />
                    <TextBox
                        x:Name="PostProcessingApiVersion"
                        Header="Azure API version"
                        PlaceholderText="Leave blank for OpenAI/Groq; e.g. 2025-03-01-preview for Azure" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Dictation" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Name="PressEnterEnabled" Header="Honor spoken &quot;press enter&quot;" OnContent="On" OffContent="Off" />
                    <TextBox
                        x:Name="OutputLanguage"
                        Header="Output language (optional)"
                        PlaceholderText="Leave blank to keep the spoken language; e.g. Spanish" />
                    <TextBox
                        x:Name="CustomVocabulary"
                        Header="Custom vocabulary"
                        PlaceholderText="Domain terms / names, comma or newline separated"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="72" />
                    <TextBox
                        x:Name="SystemPrompt"
                        Header="Dictation cleanup prompt (optional override)"
                        PlaceholderText="Leave blank to use the built-in cleanup prompt"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="96" />
                    <TextBox
                        x:Name="ContextSystemPrompt"
                        Header="Command / edit prompt (optional override)"
                        PlaceholderText="Leave blank to use the built-in edit-mode prompt"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="96" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Edit Mode" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Dictate over selected text to transform it with a spoken instruction (e.g. &quot;make this shorter&quot;). Automatic acts whenever text is selected; Manual also requires an extra modifier key."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="EditModeEnabled" Header="Enable Edit Mode" OnContent="On" OffContent="Off" />
                    <ComboBox x:Name="EditModeStyle" Header="Invocation" Width="220">
                        <ComboBoxItem Content="Automatic" />
                        <ComboBoxItem Content="Manual (hold extra modifier)" />
                    </ComboBox>
                    <ComboBox x:Name="EditModeModifier" Header="Manual modifier" Width="220">
                        <ComboBoxItem Content="Ctrl" />
                        <ComboBoxItem Content="Alt" />
                        <ComboBoxItem Content="Shift" />
                        <ComboBoxItem Content="Win" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Voice macros" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Say the command phrase on its own and FreeFlow pastes the expansion verbatim, skipping cleanup."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ItemsControl x:Name="MacrosList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Spoken phrase" />
                                    <TextBox
                                        Grid.Column="1"
                                        Text="{Binding Payload, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Expansion to paste"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Column="2"
                                        Click="OnRemoveMacroClick"
                                        Tag="{Binding}"
                                        VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="AddMacroButton" Click="OnAddMacroClick" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" />
                            <TextBlock Text="Add macro" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Shortcuts" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox x:Name="HoldToTalk" Header="Hold-to-talk (e.g. RightCtrl)" />
                    <TextBox x:Name="Toggle" Header="Toggle (e.g. Ctrl+Alt+Space)" />
                    <TextBox x:Name="PasteAgain" Header="Paste-again (e.g. Ctrl+Alt+V)" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        x:Name="MicDevice"
                        Header="Microphone"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Name"
                        SelectedValuePath="Id" />
                    <ToggleSwitch x:Name="LaunchAtLogin" Header="Launch at login" OnContent="On" OffContent="Off" />
                    <ToggleSwitch x:Name="PlaySounds" Header="Play recording sounds" OnContent="On" OffContent="Off" />
                    <ToggleSwitch x:Name="ShowOverlay" Header="Show recording overlay" OnContent="On" OffContent="Off" />
                    <NumberBox x:Name="HistoryCap" Header="History entries kept" Minimum="1" Maximum="10000" SpinButtonPlacementMode="Inline" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button x:Name="BackButton" Content="Back" Click="OnBackClick" />
            <Button x:Name="ValidateButton" Content="Validate" Click="OnValidateClick" />
            <Button x:Name="SaveButton" Content="Save" Click="OnSaveClick" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
